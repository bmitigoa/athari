/**
 * @file
 * Example of web/sites/default/settings.local.php for Athari Donate.
 *
 * Copy these lines into web/sites/default/settings.local.php (which is
 * git-ignored) and fill in the values from your Daraja developer portal app.
 * NEVER commit real values.
 *
 * Optionally, read them from environment variables instead:
 *   $config['athari_donate.settings']['consumer_key'] = getenv('DARAJA_CONSUMER_KEY') ?: '';
 */

